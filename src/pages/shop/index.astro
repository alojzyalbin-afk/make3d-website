---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCatalog } from '../../lib/library';

const { products, categories } = await getCatalog();
const order = new Map(categories.map((c, i) => [c.slug, i]));
const sorted = [...products].sort(
  (a, b) => (order.get(a.category) ?? 99) - (order.get(b.category) ?? 99) || a.name.localeCompare(b.name)
);
---

<Layout
  title="Shop Personalised 3D Printed Gifts, Made in Dublin"
  description="Personalised keyrings, Irish fridge magnets, name lights, home decor and keepsakes, 3D printed to order in Dublin. Free collection in Dublin or delivery across Ireland."
>
  <section class="max-w-6xl mx-auto px-5 sm:px-8 py-12 md:py-16">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Shop', href: '/shop/' }]} />

    <h1 class="font-display font-bold text-3xl sm:text-4xl mb-4">Personalised 3D printed gifts</h1>
    <p class="text-paper/70 leading-relaxed max-w-xl mb-10">
      Everything here is 3D printed to order in Dublin, with your names, places and colours. Pick a category, or browse the lot.
    </p>

    <CategoryNav categories={categories} total={products.length} active="all" />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((product) => <ProductCard product={product} />)}
    </div>

    <div class="mt-16 p-8 rounded-2xl bg-panel border border-paper/10">
      <h2 class="font-display font-semibold text-xl mb-2">Don't see what you need?</h2>
      <p class="text-paper/70 leading-relaxed mb-5 max-w-lg">
        Most of what I make starts as someone's idea, a photo or a broken part that can't be bought anymore. Send me the details and I'll come back with a price.
      </p>
      <a href="/custom-3d-printing-dublin/"
        class="inline-flex items-center gap-2 bg-red text-paper font-display font-semibold px-6 py-3 rounded-full hover:bg-red/90 transition-colors focus-visible:outline-2 focus-visible:outline-gold">
        Custom 3D printing
      </a>
    </div>
  </section>
</Layout>
