---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ProductIcon from '../../components/ProductIcon.astro';
import { getCategoryMap, getDetailMap, resolveCategory, resolveDetails, SHIPPING } from '../../lib/library';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const p = product.data;

const categoryMap = await getCategoryMap();
const detailMap = await getDetailMap();
const categoryName = resolveCategory(p.category, categoryMap);
const detailLines = resolveDetails(p.details, detailMap);
const shipping = SHIPPING[p.shipping];
---

<Layout title={p.name} description={p.tagline} image={p.images[0]}>

  <section class="max-w-6xl mx-auto px-5 sm:px-8 py-12 md:py-16">
    <a href="/#products" class="text-sm text-paper/60 hover:text-gold transition-colors inline-flex items-center gap-1 mb-8">
      ← Back to all products
    </a>

    <div class="grid md:grid-cols-2 gap-12">

      <div>
        <p class="font-mono text-xs tracking-widest text-gold uppercase mb-3">{categoryName}</p>
        <h1 class="font-display font-bold text-3xl sm:text-4xl mb-6">{p.heading}</h1>

        {p.images.length > 0 ? (
          <div class="mb-8">
            <!-- object-contain so portrait and landscape photos both show in full -->
            <div class="rounded-2xl overflow-hidden border border-paper/10 bg-panel aspect-[4/5]">
              <picture>
                <source srcset={p.images[0].replace(/\.(jpg|jpeg|png)$/i, '.webp')} type="image/webp" />
                <img id="gallery-main" src={p.images[0]} alt={p.name} width="1200" height="1500" decoding="async"
                  class="w-full h-full object-contain transition-opacity duration-200" />
              </picture>
            </div>

            {p.images.length > 1 && (
              <div class="flex gap-3 mt-3 overflow-x-auto no-scrollbar pb-1">
                {p.images.map((img, i) => (
                  <button type="button" data-src={img} aria-label={`View photo ${i + 1}`}
                    class={`gallery-thumb shrink-0 w-20 h-20 rounded-lg overflow-hidden border-2 transition-colors ${i === 0 ? 'border-gold' : 'border-paper/15 hover:border-paper/40'}`}>
                    <img src={img} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  </button>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="rounded-2xl border border-paper/10 bg-panel aspect-[4/5] flex items-center justify-center mb-8">
            <ProductIcon icon={p.icon} size={72} />
          </div>
        )}

        <div class="product-body text-paper/70 leading-relaxed mb-8 max-w-md space-y-4">
          <Content />
        </div>

        {detailLines.length > 0 && (
          <div class="space-y-2 text-sm text-paper/65 border-t border-paper/10 pt-6">
            {detailLines.map((detail) => <p>· {detail}</p>)}
          </div>
        )}

        <details class="group mt-6 border-t border-paper/10 pt-6 max-w-md text-sm text-paper/65 leading-relaxed">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-3 font-mono text-xs uppercase tracking-widest text-gold">
            Before you buy
            <span class="transition-transform group-open:rotate-45 text-base leading-none" aria-hidden="true">+</span>
          </summary>
          <div class="product-body space-y-3 mt-4">
            <p>Every piece is 3D printed to order in Dublin. Because it is built up layer by layer in plastic, please know what to expect:</p>
            <ul>
              <li>Fine layer lines are part of the look. The surface is not smooth like moulded plastic. You may see or feel the lines where each layer was printed.</li>
              <li>The side that was printed against the build plate has a fine texture from the textured PEI plate I use.</li>
              <li>Small seam marks can appear where each layer starts and ends. They look like a thin line or tiny bumps.</li>
              <li>Small marks or tiny spots can appear, especially where one colour meets another. They come from the printing process and cannot be wiped off.</li>
              <li>Colours can look a little different from the photos, depending on your screen and the light.</li>
            </ul>
            <p>These are normal for 3D printing and do not affect how the item works. Because each piece is made to order, no two are exactly alike.</p>
            <p>If you have any questions before you buy, send me a message and I will be happy to help.</p>
          </div>
        </details>
      </div>

      <div class="md:sticky md:top-24 md:self-start">
        <QuoteForm
          slug={product.id}
          name={p.name}
          fromPrice={p.fromPrice}
          priceMode={p.priceMode}
          optionsLabel={p.optionsLabel}
          options={p.options}
          sizes={p.sizes}
          tiers={p.tiers}
          customFields={p.customFields}
          hasEtsy={!!p.etsyUrl}
          freeIreland={p.shipping === 'free-ireland'}
        />

        {p.etsyUrl && (
          <div class="mt-5">
            <div class="flex items-center gap-4 mb-5">
              <span class="h-px flex-1 bg-paper/10"></span>
              <span class="font-mono text-xs uppercase tracking-widest text-muted">or</span>
              <span class="h-px flex-1 bg-paper/10"></span>
            </div>

            <a
              href={p.etsyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2.5 w-full border border-paper/20 rounded-full py-3.5 font-display font-semibold text-paper hover:border-gold hover:text-gold transition-colors focus-visible:outline-2 focus-visible:outline-gold"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.3 3.2h9.9c.3 0 .5.2.6.5l.9 3.6c.1.4-.2.7-.6.7h-1.2c-.2-1.4-.5-2.6-2.6-2.6H9.6v5.2h2.5c1 0 1.3-.6 1.5-1.6h1.1v4.7h-1.1c-.2-1-.5-1.6-1.5-1.6H9.6v4.5c0 1.1.3 1.5 1.6 1.5h2.1c2.2 0 2.7-1.3 3.1-2.9h1.1l-.5 4.1H4.9v-1.1l1.2-.2c.6-.1.8-.3.8-.9V5.6c0-.5-.2-.7-.8-.8L4.9 4.6V3.5c.5 0 1.1-.1 1.4-.3z" />
              </svg>
              Buy now on Etsy
            </a>

            <p class="text-sm text-paper/55 leading-relaxed mt-3 text-center">
              Pay straight away, with Etsy buyer protection and my shop reviews.
            </p>
          </div>
        )}

        <div class="mt-6 rounded-2xl border border-paper/10 p-6">
          <h2 class="font-mono text-xs uppercase tracking-widest text-gold mb-4">Delivery</h2>
          <table class="w-full text-sm">
            <tbody>
              <tr class="border-b border-paper/10">
                <th scope="row" class="text-left font-normal text-paper/70 py-2">Collection in Dublin</th>
                <td class="text-right font-semibold py-2">Free</td>
              </tr>
              {shipping.rows.map((row) => (
                <tr class="border-b border-paper/10 last:border-0">
                  <th scope="row" class="text-left font-normal text-paper/70 py-2">{row.region}</th>
                  <td class="text-right py-2">
                    <span class="font-semibold">{row.price}</span>
                    {'extra' in row && row.extra && (
                      <span class="block text-xs text-paper/55">+{row.extra} each extra item</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-paper/55 leading-relaxed mt-4">
            Made to order in Dublin and posted from Ireland, so EU buyers pay no customs fees.
            {p.shipping === 'standard' && (
              <> Outside the EU, import duties and taxes are set by your country and paid by you on delivery. I message you an estimate before I post, and only ship once you agree.</>
            )}
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- JSON-LD structured data for Google -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: p.tagline,
    image: p.images[0] ? new URL(p.images[0], 'https://make3d.ie').href : undefined,
    brand: { '@type': 'Brand', name: 'make3d.ie' },
    offers: {
      '@type': 'Offer',
      price: p.fromPrice,
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url: `https://make3d.ie/shop/${product.id}`,
      seller: {
        '@type': 'Organization',
        name: 'Custom 3D Prints Ireland',
        url: 'https://make3d.ie',
      },
    },
  })} />

</Layout>

<script>
  const main = document.getElementById('gallery-main') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (!main || !src) return;

      main.style.opacity = '0';
      const swap = () => {
        main.src = src;
        main.style.opacity = '1';
      };
      setTimeout(swap, 150);

      thumbs.forEach((t) => {
        t.classList.remove('border-gold');
        t.classList.add('border-paper/15', 'hover:border-paper/40');
      });
      thumb.classList.add('border-gold');
      thumb.classList.remove('border-paper/15', 'hover:border-paper/40');
    });
  });
</script>
