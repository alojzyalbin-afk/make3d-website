---
const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/#services', label: 'Services' },
  { href: '/#about', label: 'About' },
  { href: '/#how-it-works', label: 'How it works' },
];
---

<header class="sticky top-0 z-50 bg-ink/90 backdrop-blur border-b border-paper/10">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    <a href="/" class="font-display font-bold text-lg tracking-tight">
      make3d<span class="text-red">.ie</span>
    </a>
    <nav class="hidden md:flex items-center gap-8 font-medium text-sm">
      {links.map((link) => (
        <a href={link.href} class="hover:text-gold transition-colors">{link.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <a
        href="https://instagram.com/custom3dprintsireland"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="opacity-70 hover:opacity-100 hover:text-gold transition-colors focus-visible:outline-2 focus-visible:outline-gold rounded"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" />
        </svg>
      </a>
      <a
        href="https://www.facebook.com/custom3dprintsdublin"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="opacity-70 hover:opacity-100 hover:text-gold transition-colors focus-visible:outline-2 focus-visible:outline-gold rounded"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M15 8h2V4h-2a4 4 0 0 0-4 4v2H9v4h2v6h3v-6h2.5l.5-4H14V8a1 1 0 0 1 1-1Z" />
        </svg>
      </a>
      <a
        href="https://www.etsy.com/shop/Make3DIE"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Etsy shop"
        class="opacity-70 hover:opacity-100 hover:text-gold transition-colors focus-visible:outline-2 focus-visible:outline-gold rounded"
      >
        <svg width="20" height="20" viewBox="4 2 14.5 19" fill="currentColor">
          <path d="M6.3 3.2h9.9c.3 0 .5.2.6.5l.9 3.6c.1.4-.2.7-.6.7h-1.2c-.2-1.4-.5-2.6-2.6-2.6H9.6v5.2h2.5c1 0 1.3-.6 1.5-1.6h1.1v4.7h-1.1c-.2-1-.5-1.6-1.5-1.6H9.6v4.5c0 1.1.3 1.5 1.6 1.5h2.1c2.2 0 2.7-1.3 3.1-2.9h1.1l-.5 4.1H4.9v-1.1l1.2-.2c.6-.1.8-.3.8-.9V5.6c0-.5-.2-.7-.8-.8L4.9 4.6V3.5c.5 0 1.1-.1 1.4-.3z" />
        </svg>
      </a>
    </div>
  </div>
</header>
