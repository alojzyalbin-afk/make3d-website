---
interface Props {
  icon: 'nameLights' | 'shadowBox' | 'dateBalloon' | 'figurines' | 'generic';
  size?: number;
}
const { icon, size = 40 } = Astro.props;
---

{icon === 'nameLights' && (
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none">
    <path d="M12 30 L20 8 L28 30" stroke="#F6F3EC" stroke-width="2" stroke-linejoin="round" />
    <circle cx="20" cy="8" r="3" fill="#D4AF37" />
  </svg>
)}

{icon === 'shadowBox' && (
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none">
    <rect x="6" y="6" width="28" height="28" rx="3" stroke="#F6F3EC" stroke-width="2" />
    <path d="M20 14 C17 10 11 12 11 17 C11 22 20 28 20 28 C20 28 29 22 29 17 C29 12 23 10 20 14Z" fill="#E7382C" />
  </svg>
)}

{icon === 'dateBalloon' && (
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none">
    <ellipse cx="20" cy="15" rx="10" ry="12" fill="#D4AF37" />
    <path d="M20 27 Q17 32 20 36" stroke="#F6F3EC" stroke-width="1.6" fill="none" />
  </svg>
)}

{icon === 'figurines' && (
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none">
    <circle cx="20" cy="12" r="6" stroke="#F6F3EC" stroke-width="2" />
    <path d="M9 34 C9 24 13 20 20 20 C27 20 31 24 31 34" stroke="#F6F3EC" stroke-width="2" fill="none" />
  </svg>
)}

{icon === 'generic' && (
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none">
    <rect x="8" y="8" width="24" height="24" rx="4" stroke="#F6F3EC" stroke-width="2" />
    <circle cx="20" cy="20" r="4" fill="#D4AF37" />
  </svg>
)}
